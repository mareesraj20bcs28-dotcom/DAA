#include <iostream>
#include "ssort.h"
using namespace std;

int main() {
    int i, n, arr[100];

    cout << "Enter size: ";
    cin >> n;

    cout << "Enter elements: ";
    for (i = 0; i < n; i++) {
        cin >> arr[i];
    }

    SelectionSort(arr, n);

    cout << "After Sorting: ";
    for (i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }

    return 0;
}


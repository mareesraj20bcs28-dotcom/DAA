#include <iostream>
#include "ssort.h"
using namespace std;

void display(int arr[], int n) {
    for (int i = 0; i < n; i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
}

void SelectionSort(int arr[], int n) {
    int i, j, min, temp;

    for (i = 0; i <= n - 2; i++) {
        min = i;
        for (j = i + 1; j <= n - 1; j++) {
            if (arr[min] > arr[j]) {
                min = j;
            }
        }

        if (min != i) {
            cout << "Swapping " << arr[i] << " and " << arr[min] << endl;
            temp = arr[i];
            arr[i] = arr[min];
            arr[min] = temp;
        } else {
            cout << "No Swapping " << arr[i] << endl;
        }
        display(arr, n);
    }
}



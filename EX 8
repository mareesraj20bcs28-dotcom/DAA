#include <iostream>
#include <cmath>
using namespace std;

class NQueens {
public:
    int x[50];
    int n;
    bool foundAny;


    NQueens() {
        foundAny = false;
    }

    bool place(int k, int i) {
        for (int j = 1; j < k; j++) {
            if (x[j] == i || abs(x[j] - i) == abs(j - k)) {
                return false;
            }
        }
        return true;
    }
    void nQueens(int k) {
        for (int i = 1; i <= n; i++) {
            if (place(k, i)) {
                x[k] = i;
                if (k == n) {
                    foundAny = true;
                    printSolution();
                } else {
                    nQueens(k + 1);
                }
            }
        }
    }
    void printSolution() {
        static int count = 1;
        cout << "\nSolution " << count++ << ":\n";
        for (int i = 1; i <= n; i++) {
            for (int j = 1; j <= n; j++) {
                if (x[i] == j) cout << "| Q ";
                else cout << "|   ";
            }
            cout << "|\n";
        }
        cout << "Positions: ";
        for (int i = 1; i <= n; i++) cout << x[i] << " ";
        cout << endl;
    }
};
int main() {
    NQueens obj;
    cout << "Enter number of queens: ";
    cin >> obj.n;

    if (obj.n > 0 && obj.n <= 50) {
        obj.nQueens(1);

        if (!obj.foundAny) {
            cout << "No solution exists for " << obj.n << " queens." << endl;
        }
    } else {
        cout << "Please enter a number between 1 and 50." << endl;
    }

    return 0;
}


